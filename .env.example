# Copy this file to `.env` (gitignored) and fill in real values.
# `.env` is loaded by both Next.js (app runtime) and drizzle-kit (CLI).

# --- Database (PostgreSQL, postgres-db container on the Synology NAS) -----
# Container is already running: postgres:latest, host port 5434,
# volume /volume1/docker/postgres/data. Fill in the NAS's LAN IP and the
# container's real POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# (from Container Manager > postgres-db > General > Environment Variables).
DATABASE_URL="postgresql://<user>:<password>@<nas-lan-ip>:5432/<database>?schema=public"

# --- Auth.js (Google OAuth) -------------------------------------------------
# No email allowlist anymore — multi-tenant now (see auth.ts): anyone with a
# Google account can sign in. An invited email joins the inviter's family; a
# fresh email gets a brand-new family and becomes its host/admin.
AUTH_SECRET=""              # generate: openssl rand -base64 32
AUTH_URL=""                 # public Cloudflare Tunnel URL, e.g. https://finflow.example.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- LINE Official Account (Messaging API + LIFF) ---------------------------
# Per-family now (lib/actions/lineCredentials.ts) — each family's host enters
# their own channel's credentials at /settings, encrypted at rest with
# ENCRYPTION_KEY below. The 4 vars here are ONLY a one-time input for
# `pnpm db:migrate-line-credentials` (backfills the single bootstrap family so
# the existing integration doesn't regress) — safe to remove from `.env`
# afterward. Day-to-day configuration lives in Settings, not here.
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
NEXT_PUBLIC_LIFF_ID=""                        # LIFF app #1: endpoint URL = ${AUTH_URL}/liff (account binding)
NEXT_PUBLIC_LIFF_ID_QUICK_RECORD=""           # LIFF app #2: endpoint URL = ${AUTH_URL}/liff/quick-record (Rich Menu "บันทึกจดเงิน" button)
                                               # Create as a separate LIFF app in the same channel (LINE Developers Console
                                               # > LIFF tab > Add), same as NEXT_PUBLIC_LIFF_ID was set up. Until this is
                                               # set, the Rich Menu button falls back to a plain chat message.

# --- Encryption (at-rest for per-family LINE OA + Gemini credentials) ------
ENCRYPTION_KEY=""            # generate: openssl rand -base64 32 — must decode to exactly 32 bytes

# --- Gemini AI Financial Coach -----------------------------------------------
# Per-family, no global fallback (lib/actions/geminiCredentials.ts) — each
# family's host enters their own Gemini API key at /settings. Nothing to
# configure here.

# --- Slip OCR (Google Cloud Vision, reuses the Gemini GCP project) ----------
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Cron (external scheduler calling /api/cron/savings-reminder) ----------
CRON_SECRET=""              # generate: openssl rand -base64 32; pass as X-Cron-Secret header (not a ?secret= query param — that ends up in logs)
