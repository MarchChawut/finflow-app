# Copy this file to `.env` (gitignored) and fill in real values.
# `.env` is loaded by both Next.js (app runtime) and drizzle-kit (CLI).

# --- Database (PostgreSQL, postgres-db container on the Synology NAS) -----
# Container is already running: postgres:latest, host port 5434,
# volume /volume1/docker/postgres/data. Fill in the NAS's LAN IP and the
# container's real POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# (from Container Manager > postgres-db > General > Environment Variables).
DATABASE_URL="postgresql://<user>:<password>@<nas-lan-ip>:5434/<database>?schema=public"

# --- Auth.js (Google OAuth + email allowlist) ------------------------------
AUTH_SECRET=""              # generate: openssl rand -base64 32
AUTH_URL=""                 # public Cloudflare Tunnel URL, e.g. https://finflow.example.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_ALLOWED_EMAILS=""     # comma-separated allowlist, e.g. chawut.san@thaimooc.ac.th

# --- LINE Official Account (Messaging API + LIFF) ---------------------------
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
NEXT_PUBLIC_LIFF_ID=""

# --- Gemini AI Financial Coach ----------------------------------------------
GEMINI_API_KEY=""

# --- Slip OCR (Google Cloud Vision, reuses the Gemini GCP project) ----------
GOOGLE_APPLICATION_CREDENTIALS=""
